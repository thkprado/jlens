{
  "cases": [
    { "name": "$sum", "expr": "$sum(nums)" },
    { "name": "$count", "expr": "$count(nums)" },
    { "name": "$max", "expr": "$max(nums)" },
    { "name": "$min", "expr": "$min(nums)" },
    { "name": "$average", "expr": "$average(nums)" },

    { "name": "$string of records", "expr": "$length($string(recs))" },
    { "name": "$string pretty", "expr": "$length($string(recs, true))" },
    { "name": "$substring", "expr": "$substring(unicode, 100, 100)" },
    { "name": "$substring from the end", "expr": "$substring(unicode, -100)" },
    { "name": "$substring at each place", "loop": true, "expr": "$count([0..(n-1)].$substring($$.text, $, 1))" },
    { "name": "$substring at each place, Unicode", "loop": true, "expr": "$count([0..(n-1)].$substring($$.unicode, $, 1))" },
    { "name": "$substringBefore", "expr": "$length($substringBefore(unicode, 'zz'))" },
    { "name": "$substringAfter", "expr": "$length($substringAfter(unicode, ' '))" },
    { "name": "$lowercase", "expr": "$length($lowercase(unicode))" },
    { "name": "$uppercase", "expr": "$length($uppercase(unicode))" },
    { "name": "$length", "expr": "$length(unicode)" },
    { "name": "$trim", "expr": "$length($trim(unicode))" },
    { "name": "$pad", "expr": "$length($pad(unicode, n * 20))" },
    { "name": "$contains text", "expr": "$contains(unicode, 'zz')" },
    { "name": "$contains regex", "expr": "$contains(unicode, /zz/)" },
    { "name": "$replace text", "expr": "$length($replace(unicode, 'o', '00'))" },
    { "name": "$replace regex", "expr": "$length($replace(unicode, /o/, '00'))" },
    { "name": "$replace with a function", "expr": "$length($replace(unicode, /o/, function($m){ '00' }))" },
    { "name": "$split text", "expr": "$count($split(unicode, ' '))" },
    { "name": "$split regex", "expr": "$count($split(unicode, / /))" },
    { "name": "$split into characters", "expr": "$count($split(unicode, ''))" },
    { "name": "$match", "expr": "$count($match(unicode, /o/))" },
    { "name": "$join", "expr": "$length($join(strs, ','))" },

    { "name": "$boolean of an array", "expr": "$boolean(nums)" },
    { "name": "$not of an array", "expr": "$not(zeros)" },

    { "name": "$map", "expr": "$count($map(nums, function($v){ $v + 1 }))" },
    { "name": "$map with the array", "expr": "$count($map(nums, function($v, $i, $a){ $a[$i] }))" },
    { "name": "$filter", "expr": "$count($filter(nums, function($v){ $v > 5 }))" },
    { "name": "$filter by index", "expr": "$count($filter(nums, function($v, $i){ $i % 2 = 0 }))" },
    { "name": "$single", "expr": "$single(nums, function($v){ $v = 1 })" },
    { "name": "$reduce", "expr": "$reduce(nums, function($a, $b){ $a + $b })" },
    { "name": "$reduce with $append", "natural": true, "expr": "$count($reduce(nums, function($a, $b){ $append($a, $b) }, []))" },
    { "name": "$reduce with &", "expr": "$length($reduce(strs, function($a, $b){ $a & $b }, ''))" },
    { "name": "$reduce with & before", "expr": "$length($reduce(strs, function($a, $b){ $b & $a }, ''))" },
    { "name": "$reduce with & of a field and a number", "expr": "$length($reduce(recs, function($a, $r){ $a & $r.key & $r.val }, ''))" },
    { "name": "$reduce with $merge", "natural": true, "expr": "$count($keys($reduce(recs, function($a, $b){ $merge([$a, {$b.key: $b.val}]) }, {})))" },
    { "name": "$sift", "expr": "$count($keys($sift(wide, function($v){ $v > 5 })))" },
    { "name": "$each", "expr": "$count($each(wide, function($v, $k){ $k }))" },

    { "name": "$keys of an object", "expr": "$count($keys(wide))" },
    { "name": "$keys of objects, same keys", "expr": "$count($keys(same))" },
    { "name": "$keys of objects, other keys", "expr": "$count($keys(singles))" },
    { "name": "$lookup in an object", "expr": "$lookup(wide, 'k5')" },
    { "name": "$lookup in objects", "expr": "$count($lookup(recs, 'id'))" },
    { "name": "$lookup at each key", "expr": "$count($keys(wide).$lookup($$.wide, $))" },
    { "name": "$spread of an object", "expr": "$count($spread(wide))" },
    { "name": "$spread of objects", "expr": "$count($spread(singles))" },
    { "name": "$merge, other keys", "expr": "$count($keys($merge(singles)))" },
    { "name": "$merge, same keys", "expr": "$merge(same).a" },

    { "name": "$append", "expr": "$count($append(nums, strs))" },
    { "name": "$reverse", "expr": "$count($reverse(nums))" },
    { "name": "$sort numbers", "expr": "$count($sort(nums))" },
    { "name": "$sort strings", "expr": "$count($sort(strs))" },
    { "name": "$sort with a function", "expr": "$count($sort(nums, function($a, $b){ $a > $b }))" },
    { "name": "$shuffle", "expr": "$count($shuffle(nums))" },
    { "name": "$distinct numbers", "expr": "$count($distinct(nums))" },
    { "name": "$distinct strings", "expr": "$count($distinct(strs))" },
    { "name": "$distinct few values", "expr": "$count($distinct(few))" },
    { "name": "$distinct records", "expr": "$count($distinct(recs))" },
    { "name": "$zip of two", "expr": "$count($zip(nums, strs))" },
    { "name": "$zip of four", "expr": "$count($zip(nums, strs, few, zeros))" },
    { "name": "$clone", "expr": "$count($clone(recs))" },
    { "name": "$type", "expr": "$type(recs)" },
    { "name": "$exists", "expr": "$exists(recs)" },
    { "name": "$eval of an array", "expr": "$count($eval($string(nums)))" },

    { "name": "$base64encode", "expr": "$length($base64encode(text))" },
    { "name": "$base64decode", "expr": "$length($base64decode($base64encode(text)))" },
    { "name": "$encodeUrlComponent", "expr": "$length($encodeUrlComponent(unicode))" },
    { "name": "$encodeUrl", "expr": "$length($encodeUrl(unicode))" },
    { "name": "$decodeUrlComponent", "expr": "$length($decodeUrlComponent($encodeUrlComponent(unicode)))" },
    { "name": "$decodeUrl", "expr": "$length($decodeUrl($encodeUrl(unicode)))" },

    { "name": "a path", "expr": "$count(recs.val)" },
    { "name": "a path over arrays", "expr": "$count(recs.tags)" },
    { "name": "a path over arrays of arrays", "expr": "$count(pairs.$)" },
    { "name": "a path of two steps", "expr": "$count(wraps.rec.id)" },
    { "name": "keep an array", "expr": "$count(recs.tags[])" },
    { "name": "a predicate", "expr": "$count(recs[val > 5].id)" },
    { "name": "a last item", "expr": "recs[-1].id" },
    { "name": "an index", "expr": "recs[100].id" },
    { "name": "an index in a loop", "loop": true, "expr": "$count($map([0..(n-1)], function($i){ $$.nums[$i] }))" },
    { "name": "many picks", "expr": "$count(nums[[0..(n-1)]])" },
    { "name": "a wildcard", "expr": "$count(wide.*)" },
    { "name": "a wildcard over objects", "expr": "$count(recs.*)" },
    { "name": "descendants", "expr": "$count(**.val)" },
    { "name": "all descendants", "expr": "$count(recs.**)" },
    { "name": "parent", "expr": "$count(recs.tags.%.id)" },
    { "name": "sort step", "expr": "$count(recs^(key).id)" },
    { "name": "sort step, two keys", "expr": "$count(recs^(group, >val).id)" },
    { "name": "focus", "expr": "$count(recs@$r.$r.id)" },
    { "name": "index", "expr": "$count(recs#$i.val)" },
    { "name": "index in a predicate", "expr": "$count(recs#$i[$i % 2 = 0].val)" },
    { "name": "group-by, few keys", "expr": "$count($keys(recs{group: $sum(val)}))" },
    { "name": "group-by, a key per item", "expr": "$count($keys(recs{key: val}))" },
    { "name": "group-by over tuples", "expr": "$count($keys(recs#$i{group: $count($i)}))" },
    { "name": "group-by, a computed key", "expr": "$count($keys(nums{$string($ % 8): $}))" },

    { "name": "in, once", "expr": "-1 in nums" },
    { "name": "in, a short list per item", "expr": "$count(nums[$ in [1, 2, 3]])" },
    { "name": "in, a long list per item", "natural": true, "expr": "$count(nums[$ in $$.rev])" },
    { "name": "= of arrays", "expr": "nums = rev" },
    { "name": "= of records", "expr": "recs = recs2" },
    { "name": "= of the same array", "expr": "recs = recs" },
    { "name": "& of an array", "expr": "$length(nums & '')" },
    { "name": "a range", "expr": "$count([1..n])" },
    { "name": "a range mapped", "expr": "$count([1..n].($ + 1))" },
    { "name": "array constructor of two arrays", "expr": "$count([nums, strs])" },
    { "name": "array constructor per item", "expr": "$count(recs.[id, val])" },
    { "name": "object constructor per item", "expr": "$count(recs.{'id': id, 'v': val})" },
    { "name": "chain", "expr": "nums ~> $reverse ~> $sum" },
    { "name": "condition over an array", "expr": "nums ? 1 : 2" },
    { "name": "coalesce", "expr": "$count(nums ?? [])" },
    { "name": "elvis", "expr": "$count(nums ?: [])" },

    { "name": "transform of each item", "expr": "$count(($ ~> |recs|{'x': 1}|).recs)" },
    { "name": "transform deleting", "expr": "$count(($ ~> |recs|{}, ['id']|).recs)" },
    { "name": "transform of the array", "expr": "$count((recs ~> |$|{'x': val}|))" },
    { "name": "transform of nested items", "expr": "$count(($ ~> |wraps.rec|{'x': 1}|).wraps)" },
    { "name": "transform of one item", "expr": "($ ~> |recs[id = 5]|{'x': 1}|).n" },

    { "name": "a tail call", "expr": "($f := function($i, $t){ $i = 0 ? $t : $f($i - 1, $t + $i) }; $f(n, 0))" },
    { "name": "a call in depth", "expr": "($f := function($i){ $i = 0 ? 0 : 1 + $f($i - 1) }; $f(n / 4))" },

    { "name": "compile an array", "prefix": "[", "repeat": "1,", "suffix": "1]" },
    { "name": "compile an object", "prefix": "{", "repeat": "'k{i}': 1,", "suffix": "'z': 1}" },
    { "name": "compile sums", "prefix": "", "repeat": "1 + ", "suffix": "1", "nest": true },
    { "name": "compile a long string", "prefix": "'", "repeat": "ação ", "suffix": "'" },
    { "name": "compile a long comment", "prefix": "/* ", "repeat": "ação ", "suffix": " */ 1" },
    { "name": "compile a Unicode array", "prefix": "[", "repeat": "'ação',", "suffix": "1]" },
    { "name": "compile a block", "prefix": "(", "repeat": "$x := 1; ", "suffix": "$x)" },
    { "name": "compile a block of names", "prefix": "(", "repeat": "$x{i} := {i}; ", "suffix": "1)" },
    { "name": "compile a long path", "prefix": "", "repeat": "a.", "suffix": "b", "nest": true },
    { "name": "compile a long regex", "prefix": "$contains('a', /", "repeat": "b|", "suffix": "a/)" },
    { "name": "compile functions", "prefix": "(", "repeat": "$f{i} := function($x){ $x + 1 }; ", "suffix": "$f0(1))" }
  ]
}
