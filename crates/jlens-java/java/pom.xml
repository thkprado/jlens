<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.thkprado</groupId>
  <artifactId>jlens</artifactId>
  <!-- The workspace's version (Cargo.toml). -->
  <version>0.24.0</version>
  <packaging>jar</packaging>

  <name>jlens</name>
  <description>JSONata for Java: jlens, a JSONata engine in Rust, called through Panama</description>
  <url>https://thkprado.github.io/jlens/</url>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>
  <scm>
    <url>https://github.com/thkprado/jlens</url>
    <connection>scm:git:https://github.com/thkprado/jlens.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The native libraries, one directory per platform, put there by `cargo xtask java`. -->
    <jlens.native>${project.basedir}/native</jlens.native>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${jlens.native}</directory>
        <targetPath>io/github/thkprado/jlens/native</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <!-- Every public item documented, and every warning an error, as in the Rust crates. -->
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Xdoclint:all/protected</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <argLine>--enable-native-access=io.github.thkprado.jlens</argLine>
          <systemPropertyVariables>
            <!-- For the test that starts a JVM without the flag. -->
            <jlens.test.classes>${project.build.outputDirectory}</jlens.test.classes>
            <jlens.test.testClasses>${project.build.testOutputDirectory}</jlens.test.testClasses>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
    </plugins>
  </build>
</project>
